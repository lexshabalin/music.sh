DATABASE_URL=postgres://musicsh:musicsh@localhost:5432/musicsh?sslmode=disable
# Optional override; if unset the server generates a key and persists it under DATA_DIR as .jwt_secret (survives restarts).
# JWT_SECRET=my-long-secret
MUSIC_DIR=./music
# Imprint (writing tags into files) needs write access to paths under MUSIC_DIR. Do not mount the library :ro in Docker/K8s if you use imprint.
DATA_DIR=./data
HTTP_ADDR=0.0.0.0:8080
# Optional: CORS_ORIGIN=https://my.domain,http://localhost:5173
# (If unset, API allows origin * without credentialed CORS; login cookie is still same-site for reverse-proxy setups.)
# Avoid on production / frequent redeploy: full-library scan+I/O spikes the box (Docker + Postgres + ffmpeg/fpcalc).
# Prefer "Scan library" in the UI, or trigger once manually after deploy.
# SCAN_ON_START=1
#
# Fewer concurrent background jobs (ffmpeg, fpcalc, MB). Default in Go without env is 3; docker-compose defaults to 1.
# WORKER_CONCURRENCY=1
# Seconds between worker polls (default 4; docker-compose sets 5).
# WORKER_POLL_SECONDS=5
# Linux only: set to 1 to skip ionice/nice around ffprobe, ffmpeg, fpcalc.
# MUSICSH_DISABLE_DISK_IO_PRIORITY=0
# Max concurrent ffprobe/ffmpeg/fpcalc processes app-wide (scan + workers). 0 = unlimited. Default in Go is 4.
# MUSICSH_MEDIA_PROC_SLOTS=4
# Large libraries on HDD: skip re-reading tags/ffprobe when file path+size+mtime match DB (built-in).
# Optional gentle pacing (sleep LIBRARY_SCAN_YIELD_MS ms every LIBRARY_SCAN_YIELD_EVERY audio files):
# docker-compose sets HDD-oriented defaults — on SSD you can go faster, e.g. EVERY=100 MS=5:
# LIBRARY_SCAN_YIELD_EVERY=25
# LIBRARY_SCAN_YIELD_MS=35
# Coalesce scan progress callbacks (Navidrome-style): wall-clock and file-count gates.
# SCAN_PROGRESS_INTERVAL_MS=500
# SCAN_PROGRESS_MIN_FILES=25
# Descend into directory symlinks when scanning (Go filepath.Walk does not). Default on; set 0 to match old behavior.
# MUSICSH_SCAN_FOLLOW_SYMLINKS=1
# Max directory nesting depth (default 256, max 10000).
# MUSICSH_SCAN_MAX_DEPTH=256
# Log and skip a file/dir on error instead of aborting the whole scan (default on). Set 0 to fail fast on first error.
# MUSICSH_SCAN_CONTINUE_ON_ERROR=1
# If using dev: run backend with DATABASE_URL, then: npm run dev in web/ (Vite proxy)
